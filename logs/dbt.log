  create view "football_warehouse"."main"."int_derived_xg__dbt_tmp" as (
    with base_matches as (
    select
        match_id,
        season_code,
        match_date,
        home_team,
        away_team,
        home_goals,
        away_goals,
        -- Actual xG if present in source dataset
        home_xg as raw_home_xg,
        away_xg as raw_away_xg,
        -- Shot metrics (coalesced to 0 if missing)
        coalesce(home_shots, 0) as home_shots,
        coalesce(away_shots, 0) as away_shots,
        coalesce(home_shots_on_target, 0) as home_shots_on_target,
        coalesce(away_shots_on_target, 0) as away_shots_on_target
    from "football_warehouse"."main"."stg_epl_matches"
),

calculated_xg as (
    select
        *,
        -- Non-target shots = Total Shots - Shots on Target
        greatest(home_shots - home_shots_on_target, 0) as home_shots_off_target,
        greatest(away_shots - away_shots_on_target, 0) as away_shots_off_target,

        -- Derived xG formula: (SoT * 0.30) + (Non-SoT * 0.05)
        round(
            (home_shots_on_target * 0.30) + (greatest(home_shots - home_shots_on_target, 0) * 0.05),
            2
        ) as derived_home_xg,
        
        round(
            (away_shots_on_target * 0.30) + (greatest(away_shots - away_shots_on_target, 0) * 0.05),
            2
        ) as derived_away_xg
    from base_matches
)

select
    match_id,
    season_code,
    match_date,
    home_team,
    away_team,
    home_goals,
    away_goals,
    -- Use raw xG if available; fallback to derived shot-proxy xG
    coalesce(raw_home_xg, derived_home_xg) as home_xg,
    coalesce(raw_away_xg, derived_away_xg) as away_xg,
    derived_home_xg,
    derived_away_xg,
    (raw_home_xg is not null) as is_native_xg
from calculated_xg
  );

