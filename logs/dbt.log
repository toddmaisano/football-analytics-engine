[0m12:00:06.638003 [debug] [Thread-2 (]: On model.football_warehouse.stg_epl_matches: /* {"app": "dbt", "dbt_version": "1.12.6", "profile_name": "football_warehouse", "target_name": "dev", "node_id": "model.football_warehouse.stg_epl_matches"} */

  
  create view "football_warehouse"."main"."stg_epl_matches__dbt_tmp" as (
    WITH source AS (
    SELECT * FROM raw.epl_historical_matches
)

SELECT
    season_code,
    TRY_CAST("Date" AS DATE) AS match_date,
    CASE 
        WHEN TRIM(HomeTeam) = 'Man City' THEN 'Manchester City'
        WHEN TRIM(HomeTeam) = 'Man United' THEN 'Manchester United'
        WHEN TRIM(HomeTeam) = 'Nott''m Forest' THEN 'Nottingham Forest'
        WHEN TRIM(HomeTeam) = 'Newcastle' THEN 'Newcastle United'
        WHEN TRIM(HomeTeam) = 'Wolves' THEN 'Wolverhampton Wanderers'
        ELSE TRIM(HomeTeam)
    END AS home_team,
    CASE 
        WHEN TRIM(AwayTeam) = 'Man City' THEN 'Manchester City'
        WHEN TRIM(AwayTeam) = 'Man United' THEN 'Manchester United'
        WHEN TRIM(AwayTeam) = 'Nott''m Forest' THEN 'Nottingham Forest'
        WHEN TRIM(AwayTeam) = 'Newcastle' THEN 'Newcastle United'
        WHEN TRIM(AwayTeam) = 'Wolves' THEN 'Wolverhampton Wanderers'
        ELSE TRIM(AwayTeam)
    END AS away_team,
    CAST(FTHG AS INT) AS home_goals,
    CAST(FTAG AS INT) AS away_goals,
    FTR AS full_time_result,
    CAST(HS AS INT) AS home_shots,
    CAST("AS" AS INT) AS away_shots,
    CAST(HST AS INT) AS home_shots_on_target,
    CAST(AST AS INT) AS away_shots_on_target
FROM source
  );

[0m12:00:06.638181 [debug] [Thread-1 (]: Using duckdb connection "model.football_warehouse.stg_belkat_team_stats"
[0m12:00:06.638363 [debug] [Thread-3 (]: On model.football_warehouse.stg_gabor_elo: /* {"app": "dbt", "dbt_version": "1.12.6", "profile_name": "football_warehouse", "target_name": "dev", "node_id": "model.football_warehouse.stg_gabor_elo"} */

  
  create view "football_warehouse"."main"."stg_gabor_elo__dbt_tmp" as (
    WITH source AS (
    SELECT
        CAST(date AS DATE) AS rating_date,
        CASE 
            WHEN TRIM(club) = 'Man City' THEN 'Manchester City'
            WHEN TRIM(club) = 'Man United' THEN 'Manchester United'
            WHEN TRIM(club) = 'Nott''m Forest' THEN 'Nottingham Forest'
            WHEN TRIM(club) = 'Newcastle' THEN 'Newcastle United'
            WHEN TRIM(club) = 'Wolves' THEN 'Wolverhampton Wanderers'
            ELSE TRIM(club)
        END AS team_name,
        country,
        CAST(elo AS DOUBLE) AS elo_rating,
        ROW_NUMBER() OVER (
            PARTITION BY 
                CAST(date AS DATE), 
                TRIM(club)
            ORDER BY date DESC
        ) AS dedup_idx
    FROM "football_warehouse"."raw"."gabor_elo"
    WHERE date IS NOT NULL AND club IS NOT NULL
)

SELECT
    rating_date,
    team_name,
    country,
    elo_rating
FROM source
WHERE dedup_idx = 1
  );

[0m12:00:06.638663 [debug] [Thread-1 (]: On model.football_warehouse.stg_belkat_team_stats: /* {"app": "dbt", "dbt_version": "1.12.6", "profile_name": "football_warehouse", "target_name": "dev", "node_id": "model.football_warehouse.stg_belkat_team_stats"} */

  
  create view "football_warehouse"."main"."stg_belkat_team_stats__dbt_tmp" as (
    WITH source AS (
    SELECT * FROM raw.hf_epl_match_stats
),

unpivoted AS (
    -- Home team perspective
    SELECT
        fixture_id AS match_id,
        TRY_CAST(stats_fetched_at AS DATE) AS match_date,
        'home' AS venue,
        CAST(home_shots_total AS INT) AS shots_total,
        CAST(home_shots_on_goal AS INT) AS shots_on_target,
        CAST(home_xg AS DOUBLE) AS xg_total
    FROM source

    UNION ALL

    -- Away team perspective
    SELECT
        fixture_id AS match_id,
        TRY_CAST(stats_fetched_at AS DATE) AS match_date,
        'away' AS venue,
        CAST(away_shots_total AS INT) AS shots_total,
        CAST(away_shots_on_goal AS INT) AS shots_on_target,
        CAST(away_xg AS DOUBLE) AS xg_total
    FROM source
)

SELECT
    match_id,
    match_date,
    venue,
    shots_total,
    shots_on_target,
    xg_total
FROM unpivoted
WHERE match_date IS NOT NULL
  );

