            WHEN TRIM(AwayTeam) = 'Newcastle' THEN 'Newcastle United'
            WHEN TRIM(AwayTeam) = 'Wolves' THEN 'Wolverhampton Wanderers'
            ELSE TRIM(AwayTeam)
        END AS away_team,
        CAST(FTHG AS INT) AS home_goals,
