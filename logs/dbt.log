  create view "football_warehouse"."main_silver"."stg_gabor_matches__dbt_tmp" as (
    WITH source AS (
    SELECT
        season,
        CAST(strptime(date, '%Y-%m-%d') AS DATE) AS match_date,
        CASE 
            WHEN TRIM(home_team) = 'Man City' THEN 'Manchester City'
            WHEN TRIM(home_team) = 'Man United' THEN 'Manchester United'
            WHEN TRIM(home_team) = 'Nott''m Forest' THEN 'Nottingham Forest'
            WHEN TRIM(home_team) = 'Newcastle' THEN 'Newcastle United'
            WHEN TRIM(home_team) = 'Wolves' THEN 'Wolverhampton Wanderers'
            ELSE TRIM(home_team)
        END AS home_team,
        CASE 
            WHEN TRIM(away_team) = 'Man City' THEN 'Manchester City'
            WHEN TRIM(away_team) = 'Man United' THEN 'Manchester United'
            WHEN TRIM(away_team) = 'Nott''m Forest' THEN 'Nottingham Forest'
            WHEN TRIM(away_team) = 'Newcastle' THEN 'Newcastle United'
            WHEN TRIM(away_team) = 'Wolves' THEN 'Wolverhampton Wanderers'
            ELSE TRIM(away_team)
        END AS away_team,
        CAST(home_goals AS INT) AS home_goals,
        CAST(away_goals AS INT) AS away_goals,
        ROW_NUMBER() OVER (
