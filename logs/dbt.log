  create view "football_warehouse"."main_silver"."stg_gabor_elo__dbt_tmp" as (
    WITH source AS (
    SELECT
        CAST(date AS DATE) AS rating_date,
        CASE 
            WHEN TRIM(club) = 'Man City' THEN 'Manchester City'
            WHEN TRIM(club) = 'Man United' THEN 'Manchester United'
            WHEN TRIM(club) = 'Nott''m Forest' THEN 'Nottingham Forest'
            WHEN TRIM(club) = 'Newcastle' THEN 'Newcastle United'
            WHEN TRIM(club) = 'Wolves' THEN 'Wolverhampton Wanderers'
            ELSE TRIM(club)
        END AS team_name,
        country,
        CAST(elo AS DOUBLE) AS elo_rating,
        ROW_NUMBER() OVER (
            PARTITION BY 
                CAST(date AS DATE), 
                TRIM(club)
            ORDER BY date DESC
        ) AS dedup_idx
    FROM "football_warehouse"."raw"."gabor_elo"
    WHERE date IS NOT NULL AND club IS NOT NULL
)

SELECT
    rating_date,
    team_name,
    country,
    elo_rating
FROM source
WHERE dedup_idx = 1
  );

[0m15:09:18.068883 [debug] [Thread-2 (]: On model.football_warehouse.stg_epl_matches: /* {"app": "dbt", "dbt_version": "1.12.6", "profile_name": "football_warehouse", "target_name": "dev", "node_id": "model.football_warehouse.stg_epl_matches"} */

  
  create view "football_warehouse"."main_silver"."stg_epl_matches__dbt_tmp" as (
    WITH source AS (
    SELECT
        season_code,
        CAST(strptime(Date, '%d/%m/%Y') AS DATE) AS match_date,
        CASE 
            WHEN TRIM(HomeTeam) = 'Man City' THEN 'Manchester City'
            WHEN TRIM(HomeTeam) = 'Man United' THEN 'Manchester United'
            WHEN TRIM(HomeTeam) = 'Nott''m Forest' THEN 'Nottingham Forest'
            WHEN TRIM(HomeTeam) = 'Newcastle' THEN 'Newcastle United'
            WHEN TRIM(HomeTeam) = 'Wolves' THEN 'Wolverhampton Wanderers'
            ELSE TRIM(HomeTeam)
        END AS home_team,
        CASE 
            WHEN TRIM(AwayTeam) = 'Man City' THEN 'Manchester City'
            WHEN TRIM(AwayTeam) = 'Man United' THEN 'Manchester United'
            WHEN TRIM(AwayTeam) = 'Nott''m Forest' THEN 'Nottingham Forest'
            WHEN TRIM(AwayTeam) = 'Newcastle' THEN 'Newcastle United'
            WHEN TRIM(AwayTeam) = 'Wolves' THEN 'Wolverhampton Wanderers'
            ELSE TRIM(AwayTeam)
        END AS away_team,
        CAST(FTHG AS INT) AS home_goals,
        CAST(FTAG AS INT) AS away_goals,
        FTR AS full_time_result,
        CAST(HS AS INT) AS home_shots,
        CAST("AS" AS INT) AS away_shots,
        CAST(HST AS INT) AS home_shots_on_target,
        CAST(AST AS INT) AS away_shots_on_target,
        ROW_NUMBER() OVER (
            PARTITION BY 
                CAST(strptime(Date, '%d/%m/%Y') AS DATE), 
                TRIM(HomeTeam), 
                TRIM(AwayTeam)
            ORDER BY Date
        ) AS dedup_idx
    FROM "football_warehouse"."raw"."epl_historical_matches"
    WHERE Date IS NOT NULL
)

SELECT
    season_code,
    match_date,
    home_team,
    away_team,
    home_goals,
    away_goals,
    full_time_result,
    home_shots,
    away_shots,
    home_shots_on_target,
    away_shots_on_target
FROM source
WHERE dedup_idx = 1
  );

