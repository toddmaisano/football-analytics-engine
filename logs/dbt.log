[0m14:45:53.154583 [debug] [Thread-2 (]: On model.football_warehouse.stg_epl_matches: /* {"app": "dbt", "dbt_version": "1.12.6", "profile_name": "football_warehouse", "target_name": "dev", "node_id": "model.football_warehouse.stg_epl_matches"} */

  
  create view "football_warehouse"."main_silver"."stg_epl_matches__dbt_tmp" as (
    WITH source AS (
    SELECT
        season_code,
        CAST(strptime(Date, '%d/%m/%Y') AS DATE) AS match_date,
        CASE 
            WHEN TRIM(HomeTeam) = 'Man City' THEN 'Manchester City'
            WHEN TRIM(HomeTeam) = 'Man United' THEN 'Manchester United'
            WHEN TRIM(HomeTeam) = 'Nott''m Forest' THEN 'Nottingham Forest'
            WHEN TRIM(HomeTeam) = 'Newcastle' THEN 'Newcastle United'
            WHEN TRIM(HomeTeam) = 'Wolves' THEN 'Wolverhampton Wanderers'
            ELSE TRIM(HomeTeam)
        END AS home_team,
        CASE 
            WHEN TRIM(AwayTeam) = 'Man City' THEN 'Manchester City'
            WHEN TRIM(AwayTeam) = 'Man United' THEN 'Manchester United'
            WHEN TRIM(AwayTeam) = 'Nott''m Forest' THEN 'Nottingham Forest'
            WHEN TRIM(AwayTeam) = 'Newcastle' THEN 'Newcastle United'
            WHEN TRIM(AwayTeam) = 'Wolves' THEN 'Wolverhampton Wanderers'
            ELSE TRIM(AwayTeam)
        END AS away_team,
        CAST(FTHG AS INT) AS home_goals,
        CAST(FTAG AS INT) AS away_goals,
        FTR AS full_time_result,
        CAST(HS AS INT) AS home_shots,
        CAST("AS" AS INT) AS away_shots,
        CAST(HST AS INT) AS home_shots_on_target,
        CAST(AST AS INT) AS away_shots_on_target,
        ROW_NUMBER() OVER (
            PARTITION BY 
                CAST(strptime(Date, '%d/%m/%Y') AS DATE), 
                TRIM(HomeTeam), 
                TRIM(AwayTeam)
            ORDER BY Date
        ) AS dedup_idx
    FROM "football_warehouse"."raw"."epl_historical_matches"
    WHERE Date IS NOT NULL
)

SELECT
    season_code,
    match_date,
    home_team,
    away_team,
    home_goals,
    away_goals,
    full_time_result,
    home_shots,
    away_shots,
    home_shots_on_target,
    away_shots_on_target
FROM source
WHERE dedup_idx = 1
  );

[0m14:45:53.154812 [debug] [Thread-1 (]: SQL status: OK in 0.001 seconds
[0m14:45:53.154992 [debug] [Thread-1 (]: Using duckdb connection "model.football_warehouse.stg_belkat_team_stats"
[0m14:45:53.155188 [debug] [Thread-1 (]: On model.football_warehouse.stg_belkat_team_stats: /* {"app": "dbt", "dbt_version": "1.12.6", "profile_name": "football_warehouse", "target_name": "dev", "node_id": "model.football_warehouse.stg_belkat_team_stats"} */

  
  create view "football_warehouse"."main_silver"."stg_belkat_team_stats__dbt_tmp" as (
    WITH source AS (
    SELECT
        season,
        matchId AS match_id,
        CAST(kickoff AS DATE) AS match_date,
        CASE 
            WHEN TRIM(team) = 'Man City' THEN 'Manchester City'
            WHEN TRIM(team) = 'Man United' THEN 'Manchester United'
            WHEN TRIM(team) = 'Nott''m Forest' THEN 'Nottingham Forest'
            WHEN TRIM(team) = 'Newcastle' THEN 'Newcastle United'
            WHEN TRIM(team) = 'Wolves' THEN 'Wolverhampton Wanderers'
            ELSE TRIM(team)
        END AS team_name,
        CAST(possessionPercentage AS DOUBLE) AS possession_pct,
        CAST(totalScoringAtt AS INT) AS shots_total,
        CAST(ontargetScoringAtt AS INT) AS shots_on_target,
        CAST(finalThirdEntries AS INT) AS final_third_entries,
        CAST(penAreaEntries AS INT) AS penalty_area_entries,
        CAST(touchesInOppBox AS INT) AS touches_in_opp_box,
        COALESCE(
            CAST(expectedGoals AS DOUBLE),
            CAST(expectedGoalsOnTarget AS DOUBLE),
            0.0
        ) AS xg_total,
        ROW_NUMBER() OVER (
            PARTITION BY matchId, TRIM(team)
            ORDER BY kickoff DESC
        ) AS dedup_idx
    FROM "football_warehouse"."raw"."pl_team_match_stats"
    WHERE kickoff IS NOT NULL
)

SELECT
    season,
    match_id,
    match_date,
    team_name,
    possession_pct,
    shots_total,
    shots_on_target,
    final_third_entries,
    penalty_area_entries,
    touches_in_opp_box,
    xg_total
FROM source
WHERE dedup_idx = 1
  );

