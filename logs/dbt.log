[0m11:57:10.695113 [debug] [Thread-1 (]: On model.football_warehouse.fct_matches: /* {"app": "dbt", "dbt_version": "1.12.6", "profile_name": "football_warehouse", "target_name": "dev", "node_id": "model.football_warehouse.fct_matches"} */

    

    create  table
      "football_warehouse"."main"."fct_matches__dbt_tmp"
  
    
    as (
      WITH epl_matches AS (
    SELECT * FROM "football_warehouse"."main"."stg_epl_matches"
),

gabor_matches AS (
    SELECT * FROM "football_warehouse"."main"."stg_gabor_matches"
),

belkat_stats AS (
    SELECT
        b.match_date,
        e.home_team,
        e.away_team,
        MAX(CASE WHEN b.team_name = e.home_team THEN b.xg_total END) AS home_xg,
        MAX(CASE WHEN b.team_name = e.away_team THEN b.xg_total END) AS away_xg
    FROM "football_warehouse"."main"."stg_belkat_team_stats" b
    JOIN epl_matches e 
      ON b.match_date = e.match_date 
     AND (b.team_name = e.home_team OR b.team_name = e.away_team)
    GROUP BY b.match_date, e.home_team, e.away_team
),

calculated_xg AS (
    SELECT
        e.season_code,
        e.match_date,
        e.home_team,
        e.away_team,

        -- Goals & Half-time
        e.home_goals,
        e.away_goals,
        e.full_time_result,
        g.ht_home_goals,
        g.ht_away_goals,
        g.ht_result,

        -- Second Half Goals (Calculated Game-State Shift)
        (e.home_goals - COALESCE(g.ht_home_goals, 0)) AS ht2_home_goals,
        (e.away_goals - COALESCE(g.ht_away_goals, 0)) AS ht2_away_goals,

        -- Shot Metrics
        e.home_shots,
        e.away_shots,
        e.home_shots_on_target,
        e.away_shots_on_target,

        -- Shot-Based xG Proxy Calculations
        ROUND(
            (COALESCE(e.home_shots_on_target, 0) * 0.30) + 
            (GREATEST(COALESCE(e.home_shots, 0) - COALESCE(e.home_shots_on_target, 0), 0) * 0.05), 
            2
        ) AS derived_home_xg,

        ROUND(
            (COALESCE(e.away_shots_on_target, 0) * 0.30) + 
            (GREATEST(COALESCE(e.away_shots, 0) - COALESCE(e.away_shots_on_target, 0), 0) * 0.05), 
            2
        ) AS derived_away_xg,

        -- Native Belkat xG
        b.home_xg AS native_home_xg,
        b.away_xg AS native_away_xg,

        -- Set Pieces & Discipline
        g.home_corners,
        g.away_corners,
        g.home_fouls,
        g.away_fouls,
        g.home_yellow_cards,
        g.away_yellow_cards,
        g.home_red_cards,
        g.away_red_cards,

        -- Elo & Form Context
        g.home_elo,
        g.away_elo,
        ROUND(g.home_elo - g.away_elo, 2) AS elo_diff,
        g.home_form_5,
        g.away_form_5,

        -- Market & Handicap
        g.odd_home,
        g.odd_draw,
        g.odd_away,
        g.handicap_size,
        g.handicap_odd_home,
        g.handicap_odd_away

    FROM epl_matches e
    LEFT JOIN gabor_matches g
        ON e.match_date = g.match_date
       AND e.home_team = g.home_team
       AND e.away_team = g.away_team
    LEFT JOIN belkat_stats b
        ON e.match_date = b.match_date
       AND e.home_team = b.home_team
       AND e.away_team = b.away_team
)

SELECT
    season_code,
    match_date,
    home_team,
    away_team,

    -- Goals & Game State
    home_goals,
    away_goals,
    full_time_result,
    ht_home_goals,
    ht_away_goals,
    ht_result,
    ht2_home_goals,
    ht2_away_goals,

    -- Expected Goals (Prioritize Belkat native xG; fallback to Shot Proxy)
    COALESCE(native_home_xg, derived_home_xg) AS home_xg,
    COALESCE(native_away_xg, derived_away_xg) AS away_xg,
    ROUND(
        COALESCE(native_home_xg, derived_home_xg) - COALESCE(native_away_xg, derived_away_xg), 
        2
    ) AS xg_diff,
    
    -- Lineage Flags & Proxies
    (native_home_xg IS NOT NULL) AS is_native_xg,
    derived_home_xg,
    derived_away_xg,

    -- Shots & Performance
    home_shots,
    away_shots,
    home_shots_on_target,
    away_shots_on_target,

    -- Set Pieces & Discipline
    home_corners,
    away_corners,
    home_fouls,
    away_fouls,
    home_yellow_cards,
    away_yellow_cards,
    home_red_cards,
    away_red_cards,

    -- Elo & Form
    home_elo,
    away_elo,
    elo_diff,
    home_form_5,
    away_form_5,

    -- Market & Handicap
    odd_home,
    odd_draw,
    odd_away,
    handicap_size,
    handicap_odd_home,
    handicap_odd_away

FROM calculated_xg
    );
    
  
