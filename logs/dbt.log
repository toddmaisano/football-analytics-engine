        ) AS dedup_idx
    FROM "football_warehouse"."raw"."gabor_elo"
    WHERE date IS NOT NULL AND club IS NOT NULL
)

SELECT
    rating_date,
    team_name,
    country,
    elo_rating
FROM source
WHERE dedup_idx = 1
  );

