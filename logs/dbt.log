  create view "football_warehouse"."main"."fct_team_match_performance__dbt_tmp" as (
    WITH match_base AS (
    SELECT * FROM "football_warehouse"."main"."fct_matches"
),

unpivoted_teams AS (
    -- Home Team Perspective
    SELECT
        match_date,
        season_code,
        home_team AS team_name,
        away_team AS opponent_name,
        'Home' AS venue,
        home_goals AS goals_for,
        away_goals AS goals_against,
        (home_goals - away_goals) AS goal_diff,
        CASE WHEN full_time_result = 'H' THEN 3 WHEN full_time_result = 'D' THEN 1 ELSE 0 END AS points_earned,
        ht_home_goals AS ht_goals_for,
        ht_away_goals AS ht_goals_against,
        ht2_home_goals AS ht2_goals_for,
        ht2_away_goals AS ht2_goals_against,
        home_xg AS xg_for,
        away_xg AS xg_against,
        (home_xg - away_xg) AS xg_diff,
        home_shots AS shots_for,
        away_shots AS shots_against,
        home_shots_on_target AS shots_on_target_for,
        away_shots_on_target AS shots_on_target_against,
        home_corners AS corners_for,
        away_corners AS corners_against,
        home_fouls AS fouls_committed,
        away_fouls AS fouls_drawn,
        home_yellow_cards AS yellow_cards,
        home_red_cards AS red_cards,
        home_elo AS team_elo,
        away_elo AS opponent_elo,
        elo_diff AS team_elo_diff,
        home_form_5 AS team_form_5
    FROM match_base

    UNION ALL

    -- Away Team Perspective
    SELECT
        match_date,
        season_code,
        away_team AS team_name,
        home_team AS opponent_name,
        'Away' AS venue,
        away_goals AS goals_for,
        home_goals AS goals_against,
        (away_goals - home_goals) AS goal_diff,
        CASE WHEN full_time_result = 'A' THEN 3 WHEN full_time_result = 'D' THEN 1 ELSE 0 END AS points_earned,
        ht_away_goals AS ht_goals_for,
        ht_home_goals AS ht_goals_against,
        ht2_away_goals AS ht2_goals_for,
        ht2_home_goals AS ht2_goals_against,
        away_xg AS xg_for,
        home_xg AS xg_against,
        (away_xg - home_xg) AS xg_diff,
        away_shots AS shots_for,
        home_shots AS shots_against,
        away_shots_on_target AS shots_on_target_for,
        home_shots_on_target AS shots_on_target_against,
        away_corners AS corners_for,
        home_corners AS corners_against,
        away_fouls AS fouls_committed,
        home_fouls AS fouls_drawn,
        away_yellow_cards AS yellow_cards,
        away_red_cards AS red_cards,
        away_elo AS team_elo,
        home_elo AS opponent_elo,
        -elo_diff AS team_elo_diff,
        away_form_5 AS team_form_5
    FROM match_base
),

belkat_stats AS (
    SELECT * FROM "football_warehouse"."main_silver"."stg_belkat_team_stats"
)

SELECT
    u.*,
    b.possession_pct,
    b.final_third_entries,
    b.penalty_area_entries,
    b.touches_in_opp_box,
    -- Analytical Efficiency Ratios
    ROUND(u.xg_for / NULLIF(u.shots_for, 0), 3) AS xg_per_shot,
    ROUND(CAST(b.touches_in_opp_box AS DOUBLE) / NULLIF(b.final_third_entries, 0), 3) AS box_penetration_rate,
    ROUND(CAST(u.corners_for AS DOUBLE) / NULLIF(b.final_third_entries, 0), 3) AS corner_per_entry_rate
FROM unpivoted_teams u
LEFT JOIN belkat_stats b
    ON u.match_date = b.match_date
   AND u.team_name = b.team_name
  );

