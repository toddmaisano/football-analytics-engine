  create view "football_warehouse"."main_silver"."stg_gabor_elo__dbt_tmp" as (
    WITH source AS (
    SELECT
        season,
        CAST(strptime(date, '%Y-%m-%d') AS DATE) AS rating_date,
        CASE 
            WHEN TRIM(team) = 'Man City' THEN 'Manchester City'
            WHEN TRIM(team) = 'Man United' THEN 'Manchester United'
            WHEN TRIM(team) = 'Nott''m Forest' THEN 'Nottingham Forest'
            WHEN TRIM(team) = 'Newcastle' THEN 'Newcastle United'
            WHEN TRIM(team) = 'Wolves' THEN 'Wolverhampton Wanderers'
            ELSE TRIM(team)
        END AS team_name,
        CAST(elo AS DOUBLE) AS elo_rating,
        ROW_NUMBER() OVER (
            PARTITION BY 
                CAST(strptime(date, '%Y-%m-%d') AS DATE), 
                TRIM(team)
            ORDER BY date DESC
        ) AS dedup_idx
    FROM "football_warehouse"."raw"."gabor_elo"
    WHERE date IS NOT NULL AND team IS NOT NULL
)

SELECT
    season,
    rating_date,
    team_name,
    elo_rating
FROM source
WHERE dedup_idx = 1
  );

