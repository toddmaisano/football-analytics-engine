[0m11:03:33.125358 [debug] [Thread-1 (]: On model.football_warehouse.fct_matches: /* {"app": "dbt", "dbt_version": "1.12.6", "profile_name": "football_warehouse", "target_name": "dev", "node_id": "model.football_warehouse.fct_matches"} */

  
  create view "football_warehouse"."main"."fct_matches__dbt_tmp" as (
    WITH epl_matches AS (
    SELECT * FROM "football_warehouse"."main"."stg_epl_matches"
),

gabor_matches AS (
    SELECT * FROM "football_warehouse"."main"."stg_gabor_matches"
),

belkat_stats AS (
    SELECT
        b.match_date,
        e.home_team,
        e.away_team,
        MAX(CASE WHEN b.team_name = e.home_team THEN b.xg_total END) AS home_xg,
        MAX(CASE WHEN b.team_name = e.away_team THEN b.xg_total END) AS away_xg
    FROM "football_warehouse"."main"."stg_belkat_team_stats" b
    JOIN epl_matches e 
      ON b.match_date = e.match_date 
     AND (b.team_name = e.home_team OR b.team_name = e.away_team)
    GROUP BY b.match_date, e.home_team, e.away_team
)

SELECT
    e.season_code,
    e.match_date,
    e.home_team,
    e.away_team,

    -- Goals & Half-time
    e.home_goals,
    e.away_goals,
    e.full_time_result,
    g.ht_home_goals,
    g.ht_away_goals,
    g.ht_result,

    -- Second Half Goals (Calculated Game-State Shift)
    (e.home_goals - COALESCE(g.ht_home_goals, 0)) AS ht2_home_goals,
    (e.away_goals - COALESCE(g.ht_away_goals, 0)) AS ht2_away_goals,

    -- Expected Goals (xG) & Shot Data
    b.home_xg,
    b.away_xg,
    ROUND(b.home_xg - b.away_xg, 2) AS xg_diff,
    e.home_shots,
    e.away_shots,
    e.home_shots_on_target,
    e.away_shots_on_target,

    -- Set Pieces & Discipline
    g.home_corners,
    g.away_corners,
    g.home_fouls,
    g.away_fouls,
    g.home_yellow_cards,
    g.away_yellow_cards,
    g.home_red_cards,
    g.away_red_cards,

    -- Elo & Form Context
    g.home_elo,
    g.away_elo,
    ROUND(g.home_elo - g.away_elo, 2) AS elo_diff,
    g.home_form_5,
    g.away_form_5,

    -- Market & Handicap
    g.odd_home,
    g.odd_draw,
    g.odd_away,
    g.handicap_size,
    g.handicap_odd_home,
    g.handicap_odd_away

FROM epl_matches e
LEFT JOIN gabor_matches g
    ON e.match_date = g.match_date
   AND e.home_team = g.home_team
   AND e.away_team = g.away_team
LEFT JOIN belkat_stats b
    ON e.match_date = b.match_date
   AND e.home_team = b.home_team
   AND e.away_team = b.away_team
  );

