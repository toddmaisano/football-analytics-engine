    away_goals,
    -- Use raw xG if available; fallback to derived shot-proxy xG
    coalesce(raw_home_xg, derived_home_xg) as home_xg,
    coalesce(raw_away_xg, derived_away_xg) as away_xg,
    derived_home_xg,
    derived_away_xg,
    (raw_home_xg is not null) as is_native_xg
from calculated_xg
  );

