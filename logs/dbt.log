  create view "football_warehouse"."main"."stg_belkat_team_stats__dbt_tmp" as (
    WITH source AS (
    SELECT * FROM raw.hf_epl_match_stats
),

unpivoted AS (
    -- Home teams
    SELECT
        fixture_id AS match_id,
        TRY_CAST(stats_fetched_at AS DATE) AS match_date,
        CASE 
            WHEN TRIM(home_team) = 'Man City' THEN 'Manchester City'
            WHEN TRIM(home_team) = 'Man United' THEN 'Manchester United'
            WHEN TRIM(home_team) = 'Nott''m Forest' THEN 'Nottingham Forest'
            WHEN TRIM(home_team) = 'Newcastle' THEN 'Newcastle United'
            WHEN TRIM(home_team) = 'Wolves' THEN 'Wolverhampton Wanderers'
            ELSE TRIM(home_team)
        END AS team_name,
        CAST(home_shots_total AS INT) AS shots_total,
        CAST(home_shots_on_goal AS INT) AS shots_on_target,
        CAST(home_xg AS DOUBLE) AS xg_total
    FROM source

    UNION ALL

    -- Away teams
    SELECT
        fixture_id AS match_id,
        TRY_CAST(stats_fetched_at AS DATE) AS match_date,
        CASE 
            WHEN TRIM(away_team) = 'Man City' THEN 'Manchester City'
            WHEN TRIM(away_team) = 'Man United' THEN 'Manchester United'
            WHEN TRIM(away_team) = 'Nott''m Forest' THEN 'Nottingham Forest'
            WHEN TRIM(away_team) = 'Newcastle' THEN 'Newcastle United'
            WHEN TRIM(away_team) = 'Wolves' THEN 'Wolverhampton Wanderers'
            ELSE TRIM(away_team)
        END AS team_name,
        CAST(away_shots_total AS INT) AS shots_total,
        CAST(away_shots_on_goal AS INT) AS shots_on_target,
        CAST(away_xg AS DOUBLE) AS xg_total
    FROM source
)

SELECT
    match_id,
    match_date,
    team_name,
    shots_total,
    shots_on_target,
    xg_total
FROM unpivoted
WHERE match_date IS NOT NULL
  );

